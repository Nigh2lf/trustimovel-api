# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True

# Database (see docker-compose.yml — these values also configure the MySQL container)
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_ROOT_PASSWORD=your_database_root_password
DB_HOST=127.0.0.1
DB_PORT=3308

# AWS S3
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# Região onde o bucket foi criado (us-east-1, sa-east-1...). Errar aqui quebra upload e URL.
AWS_S3_REGION_NAME=us-east-1
# Opcional: domínio próprio na frente do bucket (ex.: CloudFront). Vazio usa o do bucket.
#AWS_S3_CUSTOM_DOMAIN=

# Email
SIB_API_KEY = your-sib-api-key-here
URL_FORGOT_PASSWORD= your-frontend-url-forgot-password?token=

# Grok / xAI (assistente Theo)
GROK_KEY_API=your-grok-api-key
GROK_API_URL=https://api.x.ai/v1/chat/completions
GROK_MODEL=grok-4
GROK_TIMEOUT=60

# Fotos de imóvel
# FORMAT: formato de gravação (toda foto é convertida para ele)
# MAX_SIDE: maior lado da foto original; THUMBNAIL_SIDE: maior lado da mini-<foto>
# ALLOWED_EXTENSIONS vale para o arquivo enviado, não para o gravado
PROPERTY_PHOTO_FORMAT=WEBP
PROPERTY_PHOTO_MAX_SIDE=1200
PROPERTY_PHOTO_THUMBNAIL_SIDE=500
PROPERTY_PHOTO_QUALITY=80
PROPERTY_PHOTO_MAX_UPLOAD_MB=10
# MAX_PER_PROPERTY: fotos ativas por imóvel (as excluídas não contam)
PROPERTY_PHOTO_MAX_PER_PROPERTY=20
PROPERTY_PHOTO_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp

# Imagens do site (banner e seção da empresa); os demais limites acima também valem para elas
SITE_IMAGE_MAX_SIDE=1920