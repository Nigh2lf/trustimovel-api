# Montado como /app/.env dentro do container da API.
# settings.py carrega o .env com override=True, então só o que estiver aqui
# sobrescreve o ambiente; o resto da configuração vem do .env do projeto.
#
# Com o banco no Railway, host e porta vêm do próprio .env e nada precisa ser
# sobreposto. Para voltar ao MySQL local do compose do Django, descomente as
# duas linhas: o container o alcança pelo host.
#DB_HOST=host.docker.internal
#DB_PORT=3308
